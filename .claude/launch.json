{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gdg-arcade",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "party-tunnel",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "party"
      ],
      "port": 3101
    },
    {
      "name": "party-screen",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "party",
        "--",
        "--local"
      ],
      "port": 3101
    },
    {
      "name": "gdg-resources",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8010",
        "--bind",
        "127.0.0.1",
        "--directory",
        "../gdg-resources"
      ],
      "port": 8010
    },
    {
      "name": "party-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "party",
        "--",
        "--lan"
      ],
      "port": 3101
    }
  ]
}
